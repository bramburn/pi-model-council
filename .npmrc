legacy-peer-deps=true

# CI placeholder: secrets.NPM_TOKEN is injected by GitHub Actions as $NPM_TOKEN
# at runtime. No token is stored in this file. For local publishing, configure
# auth in your user-level ~/.npmrc (run: npm config set //registry.npmjs.org/:_authToken <token>).
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
